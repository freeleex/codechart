exports[`renderFlowTree > previews at a budget of 5, counting cut steps 1`] = `
"read file or stdin → validate spec → load config
◇ ~output mode?
├─ none     → exit, no output
├─ cli      → … (+1 steps in web view)
├─ auto     → … (+7 steps in web view)
└─ web|both → …

13 steps · 1 new · 2 changed · 0 planned
key: + new  ~ changed  ? planned  ◇ decision  ⤷ shared step
gaps: did not check behaviour when stdin is a TTY
full map → file:///tmp/x/render.html
"
`;

exports[`renderFlowTree > titles a plan with planned steps and marks planned steps and branches 1`] = `
"planned flow
read spec
◇ diagram?
├─ map   → render map
├─ ?flow → ?render flow tree → ?print
└─ ?none → skip

6 steps · 0 new · 0 changed · 2 planned
key: + new  ~ changed  ? planned  ◇ decision  ⤷ shared step
"
