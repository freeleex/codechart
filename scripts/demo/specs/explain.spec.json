{
  "title": "How refunds and invoices work",
  "kind": "explain",
  "nodes": [
    {
      "id": "refund",
      "label": "POST /orders/{id}/refund",
      "kind": "endpoint",
      "status": "existing",
      "layer": "api",
      "summary": "Marks a paid order refunded",
      "path": "shop/api/refunds.py",
      "match": "def refund(order_id: str):",
      "notes": ["Answers 404, not 403, while refundsEnabled is off"]
    },
    {
      "id": "flag",
      "label": "refundsEnabled",
      "kind": "config",
      "status": "existing",
      "layer": "api",
      "summary": "Feature flag that switches refunds on",
      "path": "config/flags.yaml",
      "match": "refundsEnabled: false"
    },
    {
      "id": "migration",
      "label": "migration 0042",
      "kind": "file",
      "status": "existing",
      "layer": "api",
      "summary": "Backfills one invoice per paid order",
      "path": "db/migrations/0042_invoices.py",
      "match": "def upgrade():"
    },
    {
      "id": "prefix",
      "label": "INVOICE_PREFIX",
      "kind": "config",
      "status": "existing",
      "layer": "api",
      "summary": "Env var put before every invoice number",
      "path": "shop/settings.py",
      "match": "INVOICE_PREFIX = os.environ.get"
    },
    {
      "id": "order",
      "label": "Order",
      "kind": "model",
      "status": "existing",
      "layer": "models",
      "summary": "An order, its buyer and its status",
      "path": "shop/models/order.py",
      "match": "class Order(Base):"
    },
    {
      "id": "status",
      "label": "OrderStatus",
      "kind": "enum",
      "status": "existing",
      "layer": "models",
      "summary": "pending, paid, shipped, refunded",
      "path": "shop/models/order_status.py",
      "match": "class OrderStatus(str, enum.Enum):"
    },
    {
      "id": "invoice",
      "label": "Invoice",
      "kind": "model",
      "status": "existing",
      "layer": "models",
      "summary": "One invoice per paid order",
      "path": "shop/models/invoice.py",
      "match": "class Invoice(Base):"
    },
    {
      "id": "method",
      "label": "PaymentMethod",
      "kind": "enum",
      "status": "existing",
      "layer": "models",
      "summary": "card, paypal, bank_transfer",
      "path": "shop/models/payment.py",
      "match": "class PaymentMethod(str, enum.Enum):"
    },
    {
      "id": "customer",
      "label": "Customer",
      "kind": "model",
      "status": "outside",
      "layer": "other areas",
      "summary": "Buyer accounts, owned by the accounts code",
      "path": "shop/models/customer.py",
      "match": "class Customer(Base):"
    },
    {
      "id": "paypal",
      "label": "PayPal",
      "kind": "other",
      "status": "outside",
      "layer": "other areas",
      "summary": "External payment provider"
    }
  ],
  "edges": [
    { "from": "refund", "to": "flag", "label": "checks", "kind": "reads" },
    { "from": "refund", "to": "order", "label": "get_order, mark_refunded", "kind": "calls" },
    { "from": "refund", "to": "status", "label": "OrderStatus.PAID", "kind": "reads" },
    { "from": "migration", "to": "invoice", "label": "creates", "kind": "writes" },
    { "from": "migration", "to": "prefix", "label": "number prefix", "kind": "reads" },
    { "from": "order", "to": "status", "label": "status", "kind": "fk" },
    { "from": "invoice", "to": "order", "label": "order_id", "kind": "fk" },
    { "from": "invoice", "to": "method", "label": "method", "kind": "fk" },
    { "from": "order", "to": "customer", "label": "customer_id", "kind": "fk" },
    { "from": "method", "to": "paypal", "label": "paypal", "kind": "other" }
  ],
  "flows": [
    {
      "id": "refund",
      "title": "Refund an order",
      "start": "receive",
      "steps": [
        {
          "id": "receive",
          "label": "receive the refund request",
          "status": "existing",
          "box": "refund",
          "source": "shop/api/refunds.py",
          "match": "def refund(order_id: str):"
        },
        {
          "id": "lookup",
          "label": "look up the refundsEnabled flag",
          "status": "existing",
          "box": "flag",
          "source": "config/flags.yaml",
          "match": "refundsEnabled: false"
        },
        {
          "id": "enabled",
          "label": "refunds switched on?",
          "status": "existing",
          "box": "refund",
          "source": "shop/api/refunds.py",
          "match": "if not flag(\"refundsEnabled\"):"
        },
        {
          "id": "off",
          "label": "answer 404",
          "status": "existing",
          "box": "refund",
          "source": "shop/api/refunds.py",
          "match": "raise HTTPException(404)"
        },
        {
          "id": "load",
          "label": "load the order",
          "status": "existing",
          "box": "refund",
          "source": "shop/api/refunds.py",
          "match": "order = get_order(order_id)"
        },
        {
          "id": "paid",
          "label": "order is paid?",
          "status": "existing",
          "box": "refund",
          "source": "shop/api/refunds.py",
          "match": "if order.status != OrderStatus.PAID:"
        },
        {
          "id": "conflict",
          "label": "answer 409",
          "status": "existing",
          "box": "refund",
          "source": "shop/api/refunds.py",
          "match": "raise HTTPException(409"
        },
        {
          "id": "mark",
          "label": "mark the order refunded",
          "status": "existing",
          "box": "order",
          "source": "shop/models/order.py",
          "match": "self.status = OrderStatus.REFUNDED"
        }
      ],
      "links": [
        {
          "from": "receive",
          "to": "lookup"
        },
        {
          "from": "lookup",
          "to": "enabled"
        },
        {
          "from": "enabled",
          "to": "off",
          "label": "no",
          "source": "shop/api/refunds.py",
          "match": "raise HTTPException(404)"
        },
        {
          "from": "enabled",
          "to": "load",
          "label": "yes",
          "source": "shop/api/refunds.py",
          "match": "order = get_order(order_id)"
        },
        {
          "from": "load",
          "to": "paid"
        },
        {
          "from": "paid",
          "to": "conflict",
          "label": "no",
          "source": "shop/api/refunds.py",
          "match": "raise HTTPException(409"
        },
        {
          "from": "paid",
          "to": "mark",
          "label": "yes",
          "source": "shop/api/refunds.py",
          "match": "order.mark_refunded()"
        }
      ]
    },
    {
      "id": "invoices",
      "title": "Create invoices for paid orders",
      "start": "run",
      "steps": [
        {
          "id": "run",
          "label": "run the migration",
          "status": "existing",
          "box": "migration",
          "source": "db/migrations/0042_invoices.py",
          "match": "def upgrade():"
        },
        {
          "id": "status",
          "label": "add the refunded status",
          "status": "existing",
          "box": "migration",
          "source": "db/migrations/0042_invoices.py",
          "match": "ADD VALUE 'refunded'"
        },
        {
          "id": "table",
          "label": "create the invoices table",
          "status": "existing",
          "box": "migration",
          "source": "db/migrations/0042_invoices.py",
          "match": "op.create_table(\"invoices\""
        },
        {
          "id": "paid",
          "label": "pick the paid orders",
          "status": "existing",
          "box": "migration",
          "source": "db/migrations/0042_invoices.py",
          "match": "FROM orders WHERE status = 'paid'"
        },
        {
          "id": "prefix",
          "label": "read the INVOICE_PREFIX setting",
          "status": "existing",
          "box": "prefix",
          "source": "shop/settings.py",
          "match": "INVOICE_PREFIX = os.environ.get"
        },
        {
          "id": "number",
          "label": "number each invoice with the prefix",
          "status": "existing",
          "box": "migration",
          "source": "db/migrations/0042_invoices.py",
          "match": "'{INVOICE_PREFIX}'"
        }
      ],
      "links": [
        {
          "from": "run",
          "to": "status"
        },
        {
          "from": "status",
          "to": "table"
        },
        {
          "from": "table",
          "to": "paid"
        },
        {
          "from": "paid",
          "to": "prefix"
        },
        {
          "from": "prefix",
          "to": "number"
        }
      ]
    }
  ],
  "gaps": ["get_order and flag(): not read"]
}
