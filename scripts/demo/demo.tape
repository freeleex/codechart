# vhs scripts/demo/demo.tape, run from a repo built by make-repo.sh (see record.sh)
Output demo-term.mp4
Set Shell zsh
Set FontSize 15
Set Width 1180
Set Height 620
Set Padding 24
Set Theme "GitHub Dark"
Set TypingSpeed 35ms

Hide
Type "export PATH=$DEMO_BIN:$PATH PS1='%F{8}~/shop%f ❯ ' && clear"
Enter
Show

Sleep 600ms
Type "agent 'add invoices for paid orders and a refund endpoint behind a flag'"
Sleep 400ms
Enter
Sleep 7s
