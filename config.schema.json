{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "defaults": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string",
          "enum": [
            "auto",
            "cli",
            "web",
            "both",
            "none"
          ]
        },
        "context": {
          "type": "string",
          "enum": [
            "short",
            "full"
          ]
        },
        "flows": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "request"
          ]
        },
        "terminalMaxNodes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "outDir": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        },
        "minNodes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "keep": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxAgeDays": {
          "type": "number",
          "minimum": 0
        },
        "open": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": false
    },
    "useBuiltinRules": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "diagram": {
            "type": "string",
            "enum": [
              "map",
              "flow"
            ]
          },
          "paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
            }
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
          },
          "output": {
            "type": "string",
            "enum": [
              "auto",
              "cli",
              "web",
              "both",
              "none"
            ]
          },
          "context": {
            "type": "string",
            "enum": [
              "short",
              "full"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
